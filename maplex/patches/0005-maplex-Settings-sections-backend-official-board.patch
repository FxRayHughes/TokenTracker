-import { Cloud, FlaskConical, Gauge, Globe, Monitor, Palette, Settings, UserRound } from "lucide-react";
+import { Cloud, FlaskConical, Gauge, Globe, Monitor, Palette, Server, Settings, Trophy, UserRound } from "lucide-react";
+import { BackendSection } from "../components/settings/BackendSection.jsx";
+import { OfficialBoardSection } from "../components/settings/OfficialBoardSection.jsx";
+import { useBackendSettings } from "../hooks/use-backend-settings.js";
