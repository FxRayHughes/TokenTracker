+  LEADERBOARD: "leaderboard",
   LOCAL_DATA: "local-data",
   ACCOUNT: "account",
   CLOUD: "cloud",
@@ -65,6 +70,7 @@ export function SettingsPage() {
   } = useNativeSettings();
   const proxySettings = useProxySettings();
   const { available: proxySettingsAvailable } = proxySettings;
+  const backendSettings = useBackendSettings();
   const toastOnReset = nativeSettings?.toastOnReset !== false;
   const confettiOnReset = nativeSettings?.confettiOnReset !== false;
   const windowsNativeSettings =
@@ -75,6 +81,7 @@ export function SettingsPage() {
   const requestedSectionAvailable =
     Object.values(SETTINGS_SECTION_IDS).includes(requestedSection) &&
     (requestedSection !== SETTINGS_SECTION_IDS.NATIVE_APP || nativeSettingsAvailable) &&
+    (requestedSection !== SETTINGS_SECTION_IDS.BACKEND || backendSettings.available) &&
     (requestedSection !== SETTINGS_SECTION_IDS.NETWORK || proxySettingsAvailable) &&
     (requestedSection !== SETTINGS_SECTION_IDS.LOCAL_DATA || isLocalDashboardHost());
   const activeSection = requestedSectionAvailable
@@ -110,6 +117,16 @@ export function SettingsPage() {
           content: <MenuBarSection />,
         }]
       : []),
+    ...(backendSettings.available && backendSettings.config
+      ? [{
+          id: SETTINGS_SECTION_IDS.BACKEND,
+          label: copy("settings.section.backend"),
+          description: copy("settings.section.backend.description"),
+          group: SETTINGS_GROUP_IDS.APP,
+          Icon: Server,
+          content: <BackendSection backendSettings={backendSettings} />,
+        }]
+      : []),
     ...(proxySettingsAvailable
       ? [{
           id: SETTINGS_SECTION_IDS.NETWORK,
@@ -136,6 +153,14 @@ export function SettingsPage() {
       Icon: Cloud,
       content: <CloudSection settings={accountSettings} active={activeSection === SETTINGS_SECTION_IDS.CLOUD} />,
     },
+    {
+      id: SETTINGS_SECTION_IDS.LEADERBOARD,
+      label: copy("settings.section.officialboard"),
+      description: copy("settings.section.officialboard.description"),
+      group: SETTINGS_GROUP_IDS.PERSONAL,
+      Icon: Trophy,
+      content: activeSection === SETTINGS_SECTION_IDS.LEADERBOARD ? <OfficialBoardSection /> : null,
+    },
     {
       id: SETTINGS_SECTION_IDS.LIMITS,
       label: copy("settings.section.limits"),
